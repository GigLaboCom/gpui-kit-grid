---
// Starlight's colour scheme picker, storing only what the reader picks.
// Starlight's own writes `starlight-theme` to local storage on every page
// load, "Auto" included; this one reads it the same way (its
// ThemeProvider reads it before the first paint), writes it only when the
// reader picks Light or Dark, and removes it when they pick Auto. A hint
// by the picker says that the choice is remembered (the Privacy page
// lists the key).
import Select from '@astrojs/starlight/components/Select.astro';
---

<starlight-theme-select title="Light or Dark is remembered in this browser; Auto forgets it">
	<Select
		icon="laptop"
		label={Astro.locals.t('themeSelect.accessibleLabel')}
		options={[
			{ label: Astro.locals.t('themeSelect.dark'), selected: false, value: 'dark' },
			{ label: Astro.locals.t('themeSelect.light'), selected: false, value: 'light' },
			{ label: Astro.locals.t('themeSelect.auto'), selected: true, value: 'auto' },
		]}
		width="6.25em"
	/>
	<small class="remembered" hidden>Remembered in this browser</small>
</starlight-theme-select>

{/* Inlined to avoid a flash of the wrong picker; `StarlightThemeProvider` is Starlight's. */}
<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	type Theme = 'auto' | 'dark' | 'light';

	/** The key Starlight's ThemeProvider reads before the first paint. */
	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

	/** The reader's choice, `auto` when none is stored (or storage is off). */
	function loadTheme(): Theme {
		try {
			return parseTheme(localStorage.getItem(storageKey));
		} catch {
			return 'auto';
		}
	}

	/** Remembers Light or Dark; Auto forgets the choice. */
	function storeTheme(theme: Theme): void {
		try {
			if (theme === 'auto') localStorage.removeItem(storageKey);
			else localStorage.setItem(storageKey, theme);
		} catch {
			// Storage is off: the choice lasts for this page.
		}
	}

	const preferredScheme = (): 'light' | 'dark' =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	/** Shows `theme` in the pickers and the page, without storing it. */
	function showTheme(theme: Theme): void {
		StarlightThemeProvider.updatePickers(theme);
		document.documentElement.dataset.theme = theme === 'auto' ? preferredScheme() : theme;
		for (const hint of document.querySelectorAll<HTMLElement>('starlight-theme-select .remembered')) {
			hint.hidden = theme === 'auto';
		}
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') showTheme('auto');
	});

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			showTheme(loadTheme());
			this.querySelector('select')?.addEventListener('change', (event) => {
				if (event.currentTarget instanceof HTMLSelectElement) {
					const theme = parseTheme(event.currentTarget.value);
					storeTheme(theme);
					showTheme(theme);
				}
			});
		}
	}
	customElements.define('starlight-theme-select', StarlightThemeSelect);
</script>

<style>
	starlight-theme-select {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.remembered {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-2xs, 0.75rem);
		white-space: nowrap;
	}
	.remembered[hidden] {
		display: none;
	}
</style>
