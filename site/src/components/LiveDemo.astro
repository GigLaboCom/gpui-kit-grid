---
// A demo as a poster that becomes the running demo on a click: the
// example's page under `/demo/<app>/?embed` in an iframe, never loaded
// before the click (about 7 MB of WebAssembly). One demo runs per page: a
// click on another puts the running one back to its poster. Before loading
// it checks that the browser draws WebGPU or WebGL 2, or keeps the poster
// and says why; on a phone, a touch screen or with Save-Data it says what
// the download costs before the click. A keyboard-first demo (`desk`) opens
// only on its full page.
//
// In development `PUBLIC_DEMO_ORIGIN` points at served examples, as on
// Play: `make -C crates/grid-web serve`, then
// `PUBLIC_DEMO_ORIGIN=http://127.0.0.1:8080/ bun run dev`.
import type { Demo } from '../lib/examples';
import { withBase } from '../lib/links';

interface Props {
	demo: Demo;
	/** What the demo is, for the poster's text and the frame's title. */
	label: string;
	/** The landing's demo: its poster loads at once, not when in view. */
	eager?: boolean;
}

const { demo, label, eager = false } = Astro.props;
const demoOrigin = import.meta.env.PUBLIC_DEMO_ORIGIN as string | undefined;
const base = demoOrigin ? new URL(demoOrigin).href : withBase('/demo/');
const query = demo.query ? `?${demo.query}` : '';
const full = `${base}${demo.app}/${query}`;
const framed = `${base}${demo.app}/?embed${demo.query ? `&${demo.query}` : ''}`;
const poster = withBase(`/posters/${demo.poster}.webp`);
---

<figure class="live-demo not-content" data-live-demo data-src={framed} data-label={label}>
	<div class="stage" data-stage>
		<img
			src={poster}
			width="1280"
			height="720"
			alt={`${label}: a still of the example running`}
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
		/>
		<div class="overlay" data-overlay>
			{
				demo.fullPageOnly ? (
					<a class="run" href={full}>
						Open the full page (≈7 MB)
					</a>
				) : (
					<button type="button" class="run" data-run>
						Run in browser (≈7 MB)
					</button>
				)
			}
			<p class="note" data-note>
				{
					demo.fullPageOnly
						? 'Keyboard-first: it runs on its own page, where its keys are its own.'
						: (demo.note ?? 'GPUI in WebAssembly, loaded only when you ask.')
				}
			</p>
		</div>
	</div>
	<figcaption class="bar">
		<a href={full}>Open full page</a>
		<button type="button" data-fullscreen hidden>Full screen</button>
		<button type="button" data-stop hidden>Stop</button>
	</figcaption>
</figure>

<script>
	// One running demo a page: starting another stops this one.
	let running: { stop(): void } | null = null;

	const canDraw = () => {
		if ('gpu' in navigator) return true;
		try {
			return Boolean(document.createElement('canvas').getContext('webgl2'));
		} catch {
			return false;
		}
	};

	// A phone, a touch screen or Save-Data: say what it costs before the click.
	const costly = () =>
		matchMedia('(pointer: coarse)').matches ||
		matchMedia('(max-width: 45rem)').matches ||
		(navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;

	for (const root of document.querySelectorAll<HTMLElement>('[data-live-demo]')) {
		const stage = root.querySelector<HTMLElement>('[data-stage]')!;
		const overlay = root.querySelector<HTMLElement>('[data-overlay]')!;
		const note = root.querySelector<HTMLElement>('[data-note]')!;
		const runButton = root.querySelector<HTMLButtonElement>('[data-run]');
		const fullscreen = root.querySelector<HTMLButtonElement>('[data-fullscreen]')!;
		const stopButton = root.querySelector<HTMLButtonElement>('[data-stop]')!;
		if (!runButton) continue;

		if (costly()) {
			runButton.textContent = 'Load anyway (≈7 MB)';
			note.textContent =
				'About 7 MB to download, and made for a mouse and a wide screen: on a phone it is small and slow.';
		}

		const demo = {
			stop() {
				stage.querySelector('iframe')?.remove();
				overlay.hidden = false;
				fullscreen.hidden = true;
				stopButton.hidden = true;
				root.removeAttribute('data-running');
				if (running === demo) running = null;
			},
		};

		runButton.addEventListener('click', () => {
			if (!canDraw()) {
				runButton.remove();
				note.textContent =
					'This browser draws neither WebGPU nor WebGL 2, which the demo needs: the picture is the demo as it runs elsewhere.';
				return;
			}
			running?.stop();
			running = demo;
			const frame = document.createElement('iframe');
			frame.src = root.dataset.src!;
			frame.title = `${root.dataset.label}, running live`;
			frame.allow = 'clipboard-write; fullscreen';
			stage.append(frame);
			overlay.hidden = true;
			fullscreen.hidden = !document.fullscreenEnabled;
			stopButton.hidden = false;
			root.setAttribute('data-running', '');
		});
		fullscreen.addEventListener('click', () => {
			stage.requestFullscreen?.().catch(() => {});
		});
		stopButton.addEventListener('click', () => demo.stop());
	}
</script>

<style>
	.live-demo {
		margin: 0;
		container-type: inline-size;
	}
	.stage {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-black);
	}
	.stage:fullscreen {
		border: 0;
		border-radius: 0;
	}
	img,
	.stage :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	img {
		object-fit: cover;
	}
	.overlay {
		position: absolute;
		inset: auto 0 0 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		padding: 2.5rem 1rem 1rem;
		background: linear-gradient(to top, hsl(210 14% 9% / 0.92) 40%, transparent);
	}
	.overlay[hidden] {
		display: none;
	}
	.run {
		padding: 0.5rem 1rem;
		border: 0;
		border-radius: 0.375rem;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font: inherit;
		font-weight: 600;
		text-decoration: none;
		cursor: default;
	}
	/* White on the light theme's dark accent: over a poster, in either theme. */
	:global([data-theme='light']) .run {
		background: var(--sl-color-accent-high);
		color: hsl(0, 0%, 100%);
	}
	.run:hover {
		filter: brightness(1.1);
	}
	.run:focus-visible,
	.bar button:focus-visible {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: 2px;
	}
	.note {
		flex: 1 1 14rem;
		margin: 0;
		color: hsl(210, 18%, 94%);
		font-size: var(--sl-text-sm);
		line-height: 1.4;
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1rem;
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
	}
	.bar a {
		color: var(--sl-color-text-accent);
	}
	.bar button {
		padding: 0;
		border: 0;
		background: none;
		color: var(--sl-color-text-accent);
		font: inherit;
		text-decoration: underline;
		cursor: default;
	}
	.bar button[hidden] {
		display: none;
	}
	/* A gallery card, or a phone: a smaller overlay over more of the poster. */
	@container (max-width: 30rem) {
		.overlay {
			padding: 1.5rem 0.75rem 0.75rem;
		}
		.run {
			padding: 0.375rem 0.75rem;
			font-size: var(--sl-text-sm);
		}
		.note {
			font-size: var(--sl-text-xs);
		}
	}
</style>
