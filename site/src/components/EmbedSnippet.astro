---
// The two lines that show an example on any page, on a page about one
// demo: the snippet Play writes (`src/lib/snippets.ts`), without a theme,
// and the buttons that open it prefilled on the snippet sites, under the
// page's own title and description. The forms are posted by the visitor's
// browser to a new tab; the MDN link carries the code in its address.
import { Code } from '@astrojs/starlight/components';
import {
	EMBED_SRC,
	snippet,
	codePen,
	jsFiddle,
	stackBlitz,
	mdnPlayground,
	type About,
} from '../lib/snippets';

interface Props {
	/** The example the snippet shows. */
	app: string;
	/** What the prefilled projects are called and say about themselves. */
	about: About;
}

const { app, about } = Astro.props;
const html = snippet(EMBED_SRC, null, app);
const prefills = [
	{ name: 'CodePen', prefill: codePen(html, about) },
	{ name: 'JSFiddle', prefill: jsFiddle(html, about) },
	{ name: 'StackBlitz', prefill: stackBlitz(html, about) },
];
const mdn = await mdnPlayground(html);
---

<Code code={html.trimEnd()} lang="html" />
<div class="open not-content">
	{
		prefills.map(({ name, prefill }) => (
			<form method="post" action={prefill.action} target="_blank" {...{ rel: 'noopener noreferrer' }}>
				{Object.entries(prefill.fields).map(([field, value]) => (
					<input type="hidden" name={field} value={value} />
				))}
				<button type="submit">Open in {name}</button>
			</form>
		))
	}
	<a class="button" href={mdn} target="_blank" rel="noopener noreferrer">Open in MDN Playground</a>
</div>

<style>
	.open {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-block: 0.75rem;
	}
	.open form {
		display: contents;
	}
	button,
	.button {
		font: inherit;
		font-size: var(--sl-text-sm);
		padding: 0.375rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
		text-decoration: none;
		cursor: default;
	}
	button:hover,
	.button:hover {
		border-color: var(--sl-color-gray-4);
	}
	button:focus-visible,
	.button:focus-visible {
		outline: 2px solid var(--sl-color-accent-high);
		outline-offset: 2px;
	}
</style>
