---
// Starlight's footer (pagination), a line about the project under it, and the
// cookie banner (cookie-consent/, active only on gkg.giglabo.com).
import Default from '@astrojs/starlight/components/Footer.astro';
import CookieConsentLoader from './cookie-consent/CookieConsentLoader.astro';
import { withBase } from '../lib/links';
---

<Default><slot /></Default>
<p class="project">
	Apache-2.0, built on <a href="https://gpui-kit.com">gpui-kit</a>.{' '}
	<a href="https://github.com/GigLaboCom/gpui-kit-grid">Repository</a>{' '}
	<span aria-hidden="true">·</span>{' '}
	<a href={withBase('/sponsor/')}>Sponsor</a>{' '}
	<span aria-hidden="true">·</span>{' '}
	<a href={withBase('/privacy/')}>Privacy</a>{' '}
	<span aria-hidden="true">·</span>{' '}
	<button type="button" class="cookie-settings" data-cookie-settings>Cookie settings</button>{' '}
	<span aria-hidden="true">·</span>{' '}
	<a href={withBase('/licenses/')}>Licenses</a>
</p>
<CookieConsentLoader />

<script>
	// Any `[data-cookie-settings]` (here and on the Privacy page) reopens the banner.
	document.addEventListener('click', (e) => {
		if ((e.target as Element | null)?.closest?.('[data-cookie-settings]')) {
			document.dispatchEvent(new Event('cookie-consent:open'));
		}
	});
</script>

<style>
	.project {
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-hairline-light);
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		text-align: center;
	}
	.project a,
	.cookie-settings {
		color: var(--sl-color-gray-2);
	}
	.cookie-settings {
		font: inherit;
		background: none;
		border: 0;
		padding: 0;
		text-decoration: underline;
		cursor: pointer;
	}
	.project a:hover,
	.cookie-settings:hover {
		color: var(--sl-color-text-accent);
	}
</style>
