---
// Every example of the repository (`src/lib/examples.ts`): those that run
// in the browser with their poster, which becomes the running demo on a
// click (`LiveDemo`, one at a time on the page; a running card takes the
// whole row), and the native-only ones without; each with what it shows,
// its `cargo run` command and its source.
import { EXAMPLES, sourceUrl } from '../lib/examples';
import LiveDemo from './LiveDemo.astro';

const inBrowser = EXAMPLES.filter((example) => example.demo);
const nativeOnly = EXAMPLES.filter((example) => !example.demo);
const id = (name: string, title: string) =>
	`${name}-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<h2 id="in-the-browser">In the browser</h2>
<p>
	These run natively and, compiled to WebAssembly, in this page: each poster becomes the
	running example on a click. Their data comes from the page's own simulator, a timetable or
	a public live source, straight to your browser.
</p>
<ul class="gallery not-content" role="list">
	{
		inBrowser.map((example) => (
			<li class="card" id={id(example.name, example.title)}>
				<LiveDemo demo={example.demo!} label={`${example.name}, ${example.title.toLowerCase()}`} />
				<h3>
					<code>{example.name}</code> {example.title}
				</h3>
				<p>{example.description}</p>
				<pre class="command"><code>{example.command}</code></pre>
				<a class="source" href={sourceUrl(example.source)}>
					Source: <code>{example.source}</code>
				</a>
			</li>
		))
	}
</ul>

<h2 id="native-only">Native only</h2>
<p>These run on the desktop, from a checkout of the repository.</p>
<ul class="gallery not-content" role="list">
	{
		nativeOnly.map((example) => (
			<li class="card" id={id(example.name, example.title)}>
				<h3>
					<code>{example.name}</code> {example.title}
				</h3>
				<p>{example.description}</p>
				<pre class="command"><code>{example.command}</code></pre>
				<a class="source" href={sourceUrl(example.source)}>
					Source: <code>{example.source}</code>
				</a>
			</li>
		))
	}
</ul>

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 1.5rem;
		margin: 1rem 0 2rem;
		padding: 0;
		list-style: none;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 0;
		margin: 0;
	}
	/* A running demo takes the row: an example is no use at card size. */
	.card:has([data-running]) {
		grid-column: 1 / -1;
	}
	h3 {
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
	}
	h3 code {
		margin-right: 0.25rem;
		font-size: 0.9em;
		color: var(--sl-color-accent-high);
	}
	p {
		margin: 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
	.command {
		margin: 0;
		padding: 0.5rem 0.75rem;
		overflow-x: auto;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background: var(--sl-color-gray-6);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
	}
	:global([data-theme='light']) .command {
		background: var(--sl-color-gray-7);
	}
	.source {
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-xs);
		overflow-wrap: anywhere;
	}
</style>
