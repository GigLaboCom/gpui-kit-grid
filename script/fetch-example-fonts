TIMEOUT = 120
# A dropped transfer resumes where it stopped, this many times per request.
RESUMES = 10
# An archive is read in windows of this size, each fetched once.
WINDOW = 1 << 20
ERRORS = (OSError, http.client.HTTPException)


def get(url, headers=None):
    request = urllib.request.Request(url, headers=headers or {})
    return urllib.request.urlopen(request, timeout=TIMEOUT)


def fetch(url, start=0, end=None):
    """The bytes `start..=end` at `url` (to the end without `end`). A
    dropped connection resumes with a range request for the rest."""
    data = bytearray()
    for _ in range(RESUMES):
        offset = start + len(data)
        ranged = offset > 0 or end is not None
        headers = {"Range": f"bytes={offset}-{'' if end is None else end}"} if ranged else {}
        try:
            with get(url, headers) as response:
                if ranged and response.status != 206:
                    raise OSError(f"{url}: no range requests (status {response.status})")
                data += response.read()
                return bytes(data)
        except http.client.IncompleteRead as error:
            data += error.partial
    raise OSError(f"{url}: the transfer kept dropping")


class RemoteFile(io.RawIOBase):
    """A file over HTTP that fetches only the windows read, so `zipfile`
    reads an archive's directory and one member, not the whole archive."""

    def __init__(self, url):
        with get(url, {"Range": "bytes=0-0"}) as response:
            self.url = response.geturl()
            if response.status == 206:
                self.size = int(response.headers["Content-Range"].rsplit("/", 1)[1])
                self.windows = {}
            else:
                # No range requests: the whole archive, once.
                data = response.read()
                self.size = len(data)
                self.windows = {ix: data[ix * WINDOW : (ix + 1) * WINDOW] for ix in range(len(data) // WINDOW + 1)}
        self.pos = 0

    def readable(self):
        return True

    def seekable(self):
        return True

    def tell(self):
        return self.pos

    def seek(self, offset, whence=io.SEEK_SET):
        base = {io.SEEK_SET: 0, io.SEEK_CUR: self.pos, io.SEEK_END: self.size}[whence]
        self.pos = base + offset
        return self.pos

    def readinto(self, buffer):
        if self.pos >= self.size:
            return 0
        ix, offset = divmod(self.pos, WINDOW)
        if ix not in self.windows:
            end = min((ix + 1) * WINDOW, self.size) - 1
            self.windows[ix] = fetch(self.url, ix * WINDOW, end)
        data = self.windows[ix][offset : offset + len(buffer)]
        buffer[: len(data)] = data
        self.pos += len(data)
        return len(data)


archives = {}


def download(url, member):
    if member is None:
        return fetch(url)
    if url not in archives:
        archives[url] = zipfile.ZipFile(RemoteFile(url))
    return archives[url].read(member)


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def main():
    failed = False
    for name, url, member, expected in FILES:
        path = DEST / name
        if path.is_file() and sha256(path.read_bytes()) == expected:
            print(f"ok       {name}")
            continue
        source = f"{url} [{member}]" if member else url
        try:
            data = download(url, member)
        except (*ERRORS, KeyError, zipfile.BadZipFile) as error:
            print(f"FAILED   {name}: {source}: {error}", file=sys.stderr)
            failed = True
            continue
        actual = sha256(data)
        if actual != expected:
            print(
                f"MISMATCH {name}: {source}\n  expected {expected}\n  got      {actual}",
                file=sys.stderr,
            )
            failed = True
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        partial = path.with_name(path.name + ".part")
        partial.write_bytes(data)
        partial.replace(path)
        print(f"fetched  {name} ({len(data)} bytes)")
    if failed:
        sys.exit(1)
    print(f"fonts in {DEST}")


if __name__ == "__main__":
    main()
