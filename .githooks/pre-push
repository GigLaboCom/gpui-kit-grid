#!/usr/bin/env bash
#
# Pre-push: the last check before commits leave the machine. For every
# commit being pushed that the remote does not have yet:
#
#   1. gitleaks scans it for secrets (.gitleaks.toml). It is required:
#      without it the push is refused.
#   2. Its message and added lines carry no absolute home paths
#      (/Users/Shared/ is allowed), no address of the global git identity
#      and nothing from <git common dir>/info/privacy-patterns (in the
#      custom-docs submodule, the superproject's list as well).
#
# This repeats what pre-commit checks, for commits made with --no-verify or
# in a clone without the hooks. Install once: script/install-hooks. To skip
# it deliberately: git push --no-verify.

set -euo pipefail

# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
remote="$1"
failed=0
say() { echo "pre-push: $*" >&2; }
zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"

patterns=("/Us""ers/[^/[:space:]]+/" "/ho""me/[^/[:space:]]+/")
labels=("an absolute macOS home path" "an absolute Linux home path")
global_email="$(git config --global user.email || true)"
if [[ -n "$global_email" ]]; then
  patterns+=("$(printf '%s' "$global_email" | sed 's/[][\.*^$()+?{}|]/\\&/g')")
  labels+=("the global git address")
fi
n=0
while IFS= read -r line; do
  n=$((n + 1))
  patterns+=("$line")
  labels+=("private pattern $n")
done < <(private_patterns)

gitleaks="$(find_gitleaks || true)"
config=()
cfg="$(gitleaks_config || true)"
[[ -n "$cfg" ]] && config=(--config "$cfg")
if [[ -z "$gitleaks" ]]; then
  gitleaks_missing | sed 's/^/pre-push: /' >&2
  failed=1
fi

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$local_oid" == "$zero" ]] && continue # a deletion
  # What the remote lacks: past its current tip when we have that commit,
  # otherwise everything not on a branch already fetched from this remote.
  if [[ "$remote_oid" != "$zero" ]] && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
    range=("$remote_oid..$local_oid")
  else
    range=("$local_oid" --not "--remotes=$remote")
  fi
  count="$(git rev-list --count "${range[@]}")"
  [[ "$count" -eq 0 ]] && continue
  say "checking $count commit(s) for $remote_ref"

  if [[ -n "$gitleaks" ]]; then
    if ! "$gitleaks" git --no-banner --redact --log-level warn \
      "${config[@]+"${config[@]}"}" --log-opts="${range[*]}" "$root" >&2; then
      say "gitleaks found a possible secret in $local_ref"
      failed=1
    fi
  fi

  # Messages, file names and added lines; removed lines do not count.
  text="$(git log -p -U0 --no-color --no-ext-diff --format='%B' "${range[@]}" |
    grep -vE '^(-|@@ |index )' | sed 's#/Us''ers/Shared/##g' || true)"
  for i in "${!patterns[@]}"; do
    if printf '%s\n' "$text" | grep -qiE -- "${patterns[$i]}"; then
      say "$local_ref adds ${labels[$i]}"
      failed=1
    fi
  done
done

if [[ $failed -ne 0 ]]; then
  say "push refused"
  exit 1
fi
